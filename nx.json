{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "npmScope": "fullstack",
  "affected": {
    "defaultBase": "main"
  },
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": ["build", "test", "lint", "e2e"],
        "parallel": true
      }
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "!{projectRoot}/**/*.spec.*"],
    "production": ["default", "!{projectRoot}/**/*.spec.*", "!{projectRoot}/**/*.test.*"]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", { "externalDependencies": ["@prisma/client"] }]
    },
    "test": {
      "inputs": ["default", { "externalDependencies": ["@nestjs/testing", "jest"] }]
    }
  },
  "projects": {
    "web": "apps/web",
    "web-e2e": "apps/web-e2e",
    "api": "apps/api",
    "types": "packages/types"
  }
}
